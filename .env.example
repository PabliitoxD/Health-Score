# Copie este arquivo para .env e preencha os valores reais.
# .env NUNCA deve ser commitado (já está no .gitignore).

# Quando definida, os dados passam a vir da API real do dashboard em vez do
# mock em server/fixtures/. Sem isso, o servidor usa dados mockados.
EXTERNAL_API_URL=https://api.bravvius.com/4.0
EXTERNAL_API_USER=dashboard
EXTERNAL_API_PASS=

# Intervalo entre sincronizações periódicas com a API real, em minutos.
SYNC_INTERVAL_MINUTES=60

# Pausa entre chamadas HTTP durante a sincronização, em milissegundos —
# conservador por padrão até confirmarmos o rate limit real da API.
EXTERNAL_API_THROTTLE_MS=150
